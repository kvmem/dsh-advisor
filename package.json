{
  "name": "dsh-super-advisor",
  "version": "0.1.11",
  "description": "DSH SuperAdvisor: on-demand second opinions with manual, model-tag, independent AI or approve-all policies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvmem/dsh-super-advisor.git"
  },
  "homepage": "https://github.com/kvmem/dsh-super-advisor#readme",
  "bugs": {
    "url": "https://github.com/kvmem/dsh-super-advisor/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "DESIGN.md",
    "ACCEPTANCE.md",
    "docs/RELEASING.md",
    "examples",
    "cordis.patch.yml",
    "docs/screenshots",
    "docs/COMPATIBILITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && node --check client/index.js && node scripts/build-client.mjs && tsc -p tsconfig.test.json && vitest run && node test/loader-smoke.mjs",
    "prepack": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "check:dsh": "node scripts/check-dsh.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-fs-local": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.3-alpha.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.3-alpha.2"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "advisor",
    "superadvisor"
  ],
  "license": "MIT"
}
